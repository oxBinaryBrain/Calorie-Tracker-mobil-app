# ---- Backend ----
# Point this at your real backend to leave mock mode. Leave empty to use the
# built-in mock API (parses entries locally, no network needed).
# POST /entries/parse       { input: string }              -> { entries: ParsedEntry[] }
# POST /entries/parse-photo { photoBase64: string }        -> { entries: ParsedEntry[] }
# POST /auth/login | /auth/signup | /auth/forgot-password
# POST /onboarding          -> { targets: UserTargets }
EXPO_PUBLIC_API_BASE_URL=

# ---- RevenueCat (leave empty to use the simulated paywall) ----
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=
EXPO_PUBLIC_ENTITLEMENT_ID=pro

# ---- Subscription product identifiers ----
EXPO_PUBLIC_PRODUCT_ID_MONTHLY=caloria_pro_monthly
EXPO_PUBLIC_PRODUCT_ID_YEARLY=caloria_pro_yearly
